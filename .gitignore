# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Raw data stays local / in Drive — never committed (CLAUDE.md)
data/raw/*
!data/raw/.gitkeep

# Phase 4 downloads the exported trend rasters into data/interim/ so the FDR
# correction can run on them. A 9-band district GeoTIFF at 100 m is tens of MB
# and is fully reproducible from the Earth Engine export, so the rasters stay
# out of the repo while the derived CSVs in data/outputs/ are committed.
data/interim/*.tif
data/interim/*.tfw
data/interim/*.tif.aux.xml

# Phase 5 downloads the raw Earth Engine exports into data/interim/ too: the
# zone-geometry GeoJSONs and the per-zone covariate CSVs. Both are staging
# copies. The SIMPLIFIED geometry and the DERIVED tables are written to
# data/outputs/ and committed; re-committing the raw exports beside them would
# double the repo for no added reproducibility.
data/interim/*.geojson
data/interim/*.csv
!data/interim/.gitkeep

# OS junk
.DS_Store
Thumbs.db
